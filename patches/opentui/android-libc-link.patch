--- a/packages/core/src/zig/build.zig
+++ b/packages/core/src/zig/build.zig
@@ -190,8 +190,17 @@ fn addNativeAudioDependencies(
     switch (target.result.os.tag) {
         .macos => addMacOSSystemLibraries(b, artifact, macos_sdk_path.?),
         .linux => {
-            artifact.linkSystemLibrary("dl");
-            artifact.linkSystemLibrary("pthread");
+            // Bionic (Android) merges dl/pthread into libc: no separate
+            // libdl/libpthread exist (only linker stubs for some), and the
+            // NDK sysroot has no libpthread stub at all, so Zig fails with
+            // "unable to find dynamic system library 'pthread'". Skip both
+            // on Android; symbols resolve via the libc.so stub linked in
+            // buildTarget, which gives the .so its NEEDED: libc.so entry.
+            const abi = target.result.abi;
+            if (abi != .android and abi != .androideabi) {
+                artifact.linkSystemLibrary("dl");
+                artifact.linkSystemLibrary("pthread");
+            }
         },
         else => {},
     }
@@ -494,6 +503,55 @@ fn buildTarget(
     addNativeAudioDependencies(b, lib, target, macos_sdk_path);
     addYogaDependencies(b, lib);
 
+    // Android/Bionic: Zig ships no Android libc, so -lc/-lc++ fail with
+    // "unable to provide libc for target". Wire the NDK sysroot manually:
+    // drop Zig's libc/libc++ linkage, take C/C++ headers from the NDK, and
+    // link the NDK libc.so + libc++_shared.so stubs directly. The stubs also
+    // give the .so its NEEDED entries so dlopen() resolves them on device
+    // (notably getauxval and friends from libc).
+    const os_tag = target.result.os.tag;
+    const abi = target.result.abi;
+    if (os_tag == .linux and (abi == .android or abi == .androideabi)) {
+        lib.link_libc = false;
+        lib.link_libcpp = false;
+        const ndk_home: ?[]const u8 = std.process.getEnvVarOwned(b.allocator, "ANDROID_NDK_HOME") catch null;
+        if (ndk_home) |ndk| {
+            const inc = std.fmt.allocPrint(b.allocator, "{s}/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/include", .{ndk}) catch null;
+            if (inc) |d| {
+                lib.addSystemIncludePath(.{ .cwd_relative = d });
+                if (std.fmt.allocPrint(b.allocator, "{s}/aarch64-linux-android", .{d}) catch null) |arch_d| {
+                    lib.addSystemIncludePath(.{ .cwd_relative = arch_d });
+                }
+            }
+            const arch_lib = std.fmt.allocPrint(b.allocator, "{s}/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/aarch64-linux-android", .{ndk}) catch null;
+            if (arch_lib) |adl| {
+                // Prefer the API-level stub dir, fall back to the top arch
+                // dir; NDK layout varies by version. Missing candidates are
+                // skipped via pathExists.
+                const libc_stubs = [_][]const u8{
+                    std.fmt.allocPrint(b.allocator, "{s}/24/libc.so", .{adl}) catch "",
+                    std.fmt.allocPrint(b.allocator, "{s}/libc.so", .{adl}) catch "",
+                };
+                for (libc_stubs) |s| {
+                    if (s.len != 0 and pathExists(s)) {
+                        lib.addObjectFile(.{ .cwd_relative = s });
+                        break;
+                    }
+                }
+                const libcpp_stubs = [_][]const u8{
+                    std.fmt.allocPrint(b.allocator, "{s}/24/libc++_shared.so", .{adl}) catch "",
+                    std.fmt.allocPrint(b.allocator, "{s}/libc++_shared.so", .{adl}) catch "",
+                };
+                for (libcpp_stubs) |s| {
+                    if (s.len != 0 and pathExists(s)) {
+                        lib.addObjectFile(.{ .cwd_relative = s });
+                        break;
+                    }
+                }
+            }
+        }
+    }
+
     const install_dir = b.addInstallArtifact(lib, .{
         .dest_dir = .{
             .override = .{
