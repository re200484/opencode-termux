diff --git a/packages/core/src/zig/build.zig b/packages/core/src/zig/build.zig
index 0c82ba3..a82307b 100644
--- a/packages/core/src/zig/build.zig
+++ b/packages/core/src/zig/build.zig
@@ -190,8 +190,17 @@ fn addNativeAudioDependencies(
     switch (target.result.os.tag) {
         .macos => addMacOSSystemLibraries(b, artifact, macos_sdk_path.?),
         .linux => {
-            artifact.linkSystemLibrary("dl");
-            artifact.linkSystemLibrary("pthread");
+            // Bionic (Android) merges dl/pthread into libc: no separate
+            // libdl/libpthread exist (only linker stubs for some), and the
+            // NDK sysroot has no libpthread stub at all, so Zig fails with
+            // "unable to find dynamic system library 'pthread'". Skip both
+            // on Android; symbols resolve via the libc.so stub linked in
+            // buildTarget, which gives the .so its NEEDED: libc.so entry.
+            const abi = target.result.abi;
+            if (abi != .android and abi != .androideabi) {
+                artifact.linkSystemLibrary("dl");
+                artifact.linkSystemLibrary("pthread");
+            }
         },
         else => {},
     }
@@ -491,6 +500,37 @@ fn buildTarget(
         .linkage = .dynamic,
     });
 
+    // On Android, the .so must have NEEDED libc.so so dlopen can resolve
+    // symbols like getauxval. Zig doesn't bundle Android libc, so we directly
+    // add the NDK sysroot's libc.so stub as a link input and put the NDK stub
+    // directories on the library search path so -lc resolves.
+    // (Bionic merges dl/pthread into libc; they exist only as linker stubs.)
+    const os_tag = target.result.os.tag;
+    const abi = target.result.abi;
+    if (os_tag == .linux and (abi == .android or abi == .androideabi)) {
+        const ndk_lib: ?[]const u8 = blk: {
+            if (std.process.getEnvVarOwned(b.allocator, "ANDROID_NDK_LIB_DIR") catch null) |dir| {
+                break :blk dir;
+            }
+            if (std.process.getEnvVarOwned(b.allocator, "ANDROID_NDK_HOME") catch null) |ndk_home| {
+                break :blk std.fmt.allocPrint(b.allocator, "{s}/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/aarch64-linux-android/24", .{ndk_home}) catch null;
+            }
+            break :blk null;
+        };
+        if (ndk_lib) |dir| {
+            // Use addObjectFile to directly link the libc.so stub without triggering
+            // Zig's native libc provision
+            const libc_path = std.fmt.allocPrint(b.allocator, "{s}/libc.so", .{dir}) catch unreachable;
+            lib.addObjectFile(.{ .cwd_relative = libc_path });
+            // Resolve -lc against the NDK stubs (both the
+            // API-level dir and its parent arch dir, layout varies by NDK).
+            lib.addLibraryPath(.{ .cwd_relative = dir });
+            if (std.fs.path.dirname(dir)) |arch_dir| {
+                lib.addLibraryPath(.{ .cwd_relative = arch_dir });
+            }
+        }
+    }
+
     addNativeAudioDependencies(b, lib, target, macos_sdk_path);
     addYogaDependencies(b, lib);
 
